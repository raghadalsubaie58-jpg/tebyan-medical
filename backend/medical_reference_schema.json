          "clinical_meaning_ar": "يرتفع مع انسداد القنوات الصفراوية وأمراض العظام",
          "high_causes_ar": ["انسداد القنوات الصفراوية", "حصى المرارة", "أمراض العظام (Paget's)", "نمو العظام الطبيعي عند الأطفال"]
        },

        "Bilirubin_Total": {
          "name_ar": "البيليروبين الكلي",
