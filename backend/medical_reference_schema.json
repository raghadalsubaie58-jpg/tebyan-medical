          "severity": {
            "mild_elevation": "< 3x upper limit: يستدعي المتابعة",
            "moderate": "3-10x: يحتاج تقييماً طبياً",
            "severe": "> 10x: تلف كبدي حاد — طوارئ"
          },
          "followup_tests": ["AST", "GGT", "Bilirubin", "Albumin", "PT/INR", "Viral hepatitis panel"]
