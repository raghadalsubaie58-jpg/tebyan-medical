        "GGT": {
          "name_ar": "غاما غلوتاميل ترانسفيراز",
          "abbreviations": ["GGT", "Gamma-GT"],
          "unit": "U/L",
          "ranges": {
            "adult_male":   {"low": 8, "high": 61},
            "adult_female": {"low": 5, "high": 36}
