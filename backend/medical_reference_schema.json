          "clinical_meaning_ar": "بروتين ينتجه الكبد — مؤشر لوظيفة الكبد التركيبية وسوء التغذية",
          "low_causes_ar": ["قصور الكبد المزمن", "سوء التغذية", "متلازمة الكلاء", "التهاب حاد"],
